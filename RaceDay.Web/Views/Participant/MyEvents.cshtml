@{
    ViewData["Title"] = "My Events";
}

<h1>My Events</h1>
<p class="lead">@ViewBag.Message</p>

<div class="mt-4">
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Spring Road Race</td>
                <td>15 Dec 2026</td>
                <td>Johannesburg</td>
                <td>Registered</td>
            </tr>
            <tr>
                <td>City Marathon</td>
                <td>05 Jan 2027</td>
                <td>Pretoria</td>
                <td>Entered</td>
            </tr>
        </tbody>
    </table>
</div>

<p class="mt-4">
    <a asp-action="Dashboard" asp-controller="Participant" class="btn btn-secondary">Back to Dashboard</a>
</p>