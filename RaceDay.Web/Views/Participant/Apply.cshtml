@model RaceDay.Web.Models.RaceEntry
@{
    ViewData["Title"] = "Race Application";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="mb-1">Race Application Form</h2>
                <p class="text-muted mb-4">Please fill in all your details to complete your entry.</p>

                <form asp-action="Apply" method="post">
                    <input type="hidden" asp-for="RaceId" />

                    <h5 class="text-primary border-bottom pb-2 mb-3">Participant Details</h5>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" required />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Age" class="form-label">Age</label>
                            <input asp-for="Age" type="number" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Gender" class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select" required>
                                <option value="">Select...</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">Emergency Contact</h5>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="EmergencyContactName" class="form-label">Contact Name</label>
                            <input asp-for="EmergencyContactName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmergencyContactPhone" class="form-label">Contact Phone</label>
                            <input asp-for="EmergencyContactPhone" class="form-control" type="tel" required />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-raceday btn-lg">Submit Application</button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>